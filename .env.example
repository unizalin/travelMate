# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Optional after creating the private Iceland journey; use its real Trip UUID.
VITE_ICELAND_TRIP_ID=

# API Keys
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_MAPBOX_TOKEN=your_mapbox_token_here
VITE_OPENCAGE_API_KEY=your_opencage_api_key_here

# Optional local Aurora push service (server-side only; never prefix private keys with VITE_).
# Defaults work with Vite on 127.0.0.1:5174. Production requires HTTPS and an actual contact.
# AURORA_APP_ORIGIN=http://127.0.0.1:5174
# AURORA_PUSH_CONTACT=https://example.com/contact
# AURORA_PUSH_DATA_DIR=.local/aurora-push
# AURORA_PUSH_PORT=8788

{
  "name": "travelmate",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && node scripts/check-member-photography-build.mjs dist",
    "build:share": "vue-tsc && vite build --config vite.share.config.ts",
    "check:share": "node scripts/check-public-build.mjs dist-share",
    "preview": "vite preview",
    "preview:qa": "vite preview --host 127.0.0.1 --port 5175 --strictPort",
    "qa:preview": "npm run test:all && npm run type-check && npm run build && npm run build:share && npm run check:share",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db-contract": "node --test tests/journey-service/migration-contract.test.mjs",
    "test:public-build": "node --test tests/public-build/check-public-build.test.mjs",
    "test:all": "npm run test && npm run test:public-build && npm run test:db-contract && npm run test:membership-db && npm run test:ledger-db && npm run test:notifications",
    "dev:notifications": "node scripts/aurora-push-server.mjs",
    "test:notifications": "node --test tests/notifications/*.test.mjs",
    "test:membership-db": "node --test tests/journey-service/fixed-membership-db.test.mjs tests/journey-service/email-binding-db.test.mjs",
    "test:ledger-db": "node --test tests/journey-service/ledger-db.test.mjs tests/journey-service/push-storage-db.test.mjs tests/journey-service/line-storage-db.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@headlessui/vue": "^1.7.22",
    "@heroicons/vue": "^2.1.5",
    "@supabase/supabase-js": "^2.45.0",
    "@tresjs/cientos": "^5.3.1",
    "@tresjs/core": "^5.4.1",
    "@vueuse/core": "^14.1.0",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "gsap": "^3.14.2",
    "leaflet": "^1.9.4",
    "marked": "^17.0.1",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "suncalc": "^1.9.0",
    "three": "^0.182.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vuedraggable": "^4.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/dompurify": "^3.0.5",
    "@types/leaflet": "^1.9.21",
    "@types/qrcode": "^1.5.6",
    "@types/suncalc": "^1.9.2",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.0.0"
  }
}
